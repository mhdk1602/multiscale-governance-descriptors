__pycache__/
*.pyc
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
*.csv
# Experiment outputs are the evidence behind the published tables, so they
# ship with the reproducibility package. The blanket rule above still covers
# scratch CSVs everywhere else.
!artifacts/**/*.csv
*.png
*.pdf
# Generated paper deliverables are tracked for the same reason. Without these
# carve-outs a regeneration would silently drop every figure and table.
!paper/dolap_dataset/figures/*.pdf
!paper/dolap_dataset/figures/*.png
!paper/dolap_dataset/tables/*.csv
data/change_risk/**
!data/change_risk/README.md

# LaTeX build byproducts
paper/*.log
paper/*.blg
paper/*.aux
paper/*.out
paper/*.bbl
